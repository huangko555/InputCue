<Window x:Class="InputCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputCue 诊断探针"
        Width="720"
        Height="620"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Closed="OnClosed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Text="输入上下文诊断探针" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#666666"
                       Text="切换到其他应用进行输入、拖选或悬停测试；返回本窗口后会保留最后一次外部观察。" />
            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal">
                <CheckBox x:Name="IndicatorEnabledCheckBox"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Checked="OnIndicatorEnabledChanged"
                          Unchecked="OnIndicatorEnabledChanged"
                          Content="启用提示" />
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Margin="22,0,0,0"
                          VerticalAlignment="Center"
                          Checked="OnStartWithWindowsChanged"
                          Unchecked="OnStartWithWindowsChanged"
                          Content="开机自动启动" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Text="显示时长 (ms)" />
                <TextBox x:Name="DisplayDurationTextBox"
                         Width="72"
                         Margin="8,0,12,0"
                         Text="1000" />
                <TextBlock VerticalAlignment="Center"
                           Text="输入后最短 (ms)" />
                <TextBox x:Name="MinimumDisplayDurationTextBox"
                         Width="72"
                         Margin="8,0,12,0"
                         Text="300" />
                <Button Padding="10,4"
                        Click="OnTimingSettingsClick"
                        Content="应用" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,12"
                Padding="12,8"
                Background="#FFF4F4F4"
                CornerRadius="6">
            <TextBlock x:Name="StatusText"
                       Text="正在启动只读探针……" />
        </Border>

        <TextBox x:Name="DiagnosticText"
                 Grid.Row="2"
                 Padding="14"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="14"
                 Text="尚未观察到外部应用。" />

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="PauseButton"
                    MinWidth="96"
                    Padding="14,7"
                    Click="OnPauseClick"
                    Content="暂停" />
            <Button Margin="10,0,0,0"
                    MinWidth="120"
                    Padding="14,7"
                    Click="OnExportClick"
                    Content="导出脱敏 JSON" />
        </StackPanel>
    </Grid>
</Window>
