<Window x:Class="InputCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputCue 诊断探针"
        Width="760"
        Height="760"
        MinWidth="700"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Closed="OnClosed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Text="输入上下文诊断探针" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#666666"
                       Text="切换到其他应用进行输入、拖选或悬停测试；返回本窗口后会保留最后一次外部观察。" />
            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal">
                <CheckBox x:Name="IndicatorEnabledCheckBox"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Checked="OnIndicatorEnabledChanged"
                          Unchecked="OnIndicatorEnabledChanged"
                          Content="启用提示" />
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Margin="22,0,0,0"
                          VerticalAlignment="Center"
                          Checked="OnStartWithWindowsChanged"
                          Unchecked="OnStartWithWindowsChanged"
                          Content="开机自动启动" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Text="提示样式" />
                <RadioButton x:Name="DotStyleRadio"
                             Margin="12,0,0,0"
                             GroupName="IndicatorStyle"
                             Tag="Dot"
                             Checked="OnStylePreviewChanged"
                             Content="圆点" />
                <RadioButton x:Name="LightBadgeStyleRadio"
                             Margin="14,0,0,0"
                             GroupName="IndicatorStyle"
                             Tag="LightBadge"
                             Checked="OnStylePreviewChanged"
                             Content="亮色徽标" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Text="显示时长 (ms)" />
                <TextBox x:Name="DisplayDurationTextBox"
                         Width="72"
                         Margin="8,0,12,0"
                         Text="1000" />
                <TextBlock VerticalAlignment="Center"
                           Text="输入后最短 (ms)" />
                <TextBox x:Name="MinimumDisplayDurationTextBox"
                         Width="72"
                         Margin="8,0,12,0"
                         Text="300" />
                <Button Padding="10,4"
                        Click="OnTimingSettingsClick"
                        Content="应用设置" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold"
                               Text="提示位置" />
                    <UniformGrid x:Name="PositionPicker"
                                 Width="210"
                                 Height="108"
                                 Margin="0,8,0,0"
                                 HorizontalAlignment="Left"
                                 Rows="3"
                                 Columns="3">
                        <RadioButton Margin="3"
                                     GroupName="IndicatorPlacement"
                                     Tag="TopLeft"
                                     Checked="OnPlacementPreviewChanged"
                                     Content="左上" />
                        <RadioButton Margin="3"
                                     GroupName="IndicatorPlacement"
                                     Tag="Top"
                                     Checked="OnPlacementPreviewChanged"
                                     Content="上方" />
                        <RadioButton Margin="3"
                                     GroupName="IndicatorPlacement"
                                     Tag="TopRight"
                                     Checked="OnPlacementPreviewChanged"
                                     Content="右上" />
                        <RadioButton Margin="3"
                                     GroupName="IndicatorPlacement"
                                     Tag="Left"
                                     Checked="OnPlacementPreviewChanged"
                                     Content="左侧" />
                        <Border Margin="3"
                                Background="#FFF4F4F4"
                                BorderBrush="#FFD0D0D0"
                                BorderThickness="1"
                                CornerRadius="3">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="│" />
                        </Border>
                        <RadioButton Margin="3"
                                     GroupName="IndicatorPlacement"
                                     Tag="Right"
                                     Checked="OnPlacementPreviewChanged"
                                     Content="右侧" />
                        <RadioButton Margin="3"
                                     GroupName="IndicatorPlacement"
                                     Tag="BottomLeft"
                                     Checked="OnPlacementPreviewChanged"
                                     Content="左下" />
                        <RadioButton Margin="3"
                                     GroupName="IndicatorPlacement"
                                     Tag="Bottom"
                                     Checked="OnPlacementPreviewChanged"
                                     Content="下方" />
                        <RadioButton Margin="3"
                                     GroupName="IndicatorPlacement"
                                     Tag="BottomRight"
                                     Checked="OnPlacementPreviewChanged"
                                     Content="右下" />
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold"
                               Text="实时预览" />
                    <Border Width="174"
                            Height="108"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Background="#FFFAFAFA"
                            BorderBrush="#FFD8D8D8"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Canvas Width="160"
                                Height="90"
                                ClipToBounds="True">
                            <Rectangle Width="2"
                                       Height="28"
                                       Canvas.Left="79"
                                       Canvas.Top="31"
                                       Fill="#FF333333" />
                            <Ellipse x:Name="PlacementPreviewDot"
                                     Width="12"
                                     Height="12"
                                     Fill="#FF2F7FD6"
                                     Stroke="#FFFFFFFF"
                                     StrokeThickness="2" />
                            <Canvas x:Name="PlacementPreviewBadge"
                                    Visibility="Collapsed">
                                <Border x:Name="PlacementPreviewBadgeShadow"
                                        Background="#FF000000" />
                                <Border x:Name="PlacementPreviewBadgeBody"
                                        Background="#FFFFFFFF"
                                        BorderBrush="#FF000000">
                                    <Viewbox x:Name="PlacementPreviewBadgeViewbox"
                                             Stretch="Uniform">
                                    <Path Data="F1 M0 8.448H39.072V31.728H34.368V12.912H4.512V31.968H0V8.448ZM2.352 24.624H37.056V29.088H2.352V24.624ZM17.04 0H21.792V44.496H17.04V0Z"
                                              Fill="#FF000000" />
                                    </Viewbox>
                                </Border>
                            </Canvas>
                        </Canvas>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="DotSizePanel"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="圆点尺寸" />
                        <TextBox x:Name="DotSizeTextBox"
                                 Width="56"
                                 Margin="8,0,0,6"
                                 TextChanged="OnPlacementPreviewChanged" />
                    </StackPanel>
                    <StackPanel x:Name="BadgeSizePanel"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Center"
                                   Text="徽标尺寸" />
                        <TextBox x:Name="BadgeSizeTextBox"
                                 Width="56"
                                 Margin="8,0,0,6"
                                 TextChanged="OnPlacementPreviewChanged" />
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="横向微调" />
                    <TextBox x:Name="HorizontalOffsetTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="8,0,0,6"
                             TextChanged="OnPlacementPreviewChanged" />
                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center"
                               Text="纵向微调" />
                    <TextBox x:Name="VerticalOffsetTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="8,0,0,6"
                             TextChanged="OnPlacementPreviewChanged" />
                    <Button Grid.Row="3"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Right"
                            Padding="10,4"
                            Click="OnResetPlacementClick"
                            Content="重置位置" />
                </Grid>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,12"
                Padding="12,8"
                Background="#FFF4F4F4"
                CornerRadius="6">
            <TextBlock x:Name="StatusText"
                       Text="正在启动只读探针……" />
        </Border>

        <TextBox x:Name="DiagnosticText"
                 Grid.Row="2"
                 Padding="14"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="14"
                 Text="尚未观察到外部应用。" />

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="PauseButton"
                    MinWidth="96"
                    Padding="14,7"
                    Click="OnPauseClick"
                    Content="暂停" />
            <Button Margin="10,0,0,0"
                    MinWidth="120"
                    Padding="14,7"
                    Click="OnExportClick"
                    Content="导出脱敏 JSON" />
        </StackPanel>
    </Grid>
</Window>
