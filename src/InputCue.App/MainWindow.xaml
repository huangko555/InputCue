<Window x:Class="InputCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:InputCue.Overlay;assembly=InputCue.Overlay"
        Title="InputCue"
        Icon="/Assets/InputCue.ico"
        Width="820"
        Height="940"
        MinWidth="820"
        MinHeight="940"
        Background="#FFF7F8FA"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Foreground="#FF18181B"
        WindowStartupLocation="CenterScreen"
        ContentRendered="OnPreviewLayoutChanged"
        LocationChanged="OnPreviewLayoutChanged"
        SizeChanged="OnPreviewLayoutChanged"
        Activated="OnWindowActivated"
        IsVisibleChanged="OnPreviewIsVisibleChanged"
        StateChanged="OnPreviewVisibilityChanged"
        Closed="OnClosed">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF1683FF" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF0875ED" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#FFEAF4FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE4E4E7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF71717A" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FFF1F2F4" />
        <SolidColorBrush x:Key="ListeningBrush" Color="#FF22C55E" />
        <SolidColorBrush x:Key="PausedBrush" Color="#FFEF4444" />

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF4F4F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFE9EAEC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF4F4F5" />
                                <Setter Property="Foreground" Value="#FF18181B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFE9EAEC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack"
                                    Width="40"
                                    Height="22"
                                    HorizontalAlignment="Left"
                                    Background="#FFD4D4D8"
                                    CornerRadius="11">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="18"
                                         Height="18"
                                         Margin="2"
                                         HorizontalAlignment="Left"
                                         Fill="#FFFFFFFF" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#FFE4E4E7" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#FFFFFFFF" />
                                <Setter Property="Foreground" Value="#FF18181B" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring"
                                         Fill="#FFFFFFFF"
                                         Stroke="#FFC9CACD"
                                         StrokeThickness="1.5" />
                                <Ellipse x:Name="CheckDot"
                                         Width="10"
                                         Height="10"
                                         Fill="{StaticResource PrimaryBrush}"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                                <Setter TargetName="CheckDot" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FF18181B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PositionRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PositionBorder"
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PositionBorder" Property="BorderBrush" Value="#FF8EC5FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PositionBorder" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter TargetName="PositionBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StepperButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StepperButtonBorder" Property="Background" Value="#FFF1F2F4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StepperButtonBorder" Property="Background" Value="#FFE4E4E7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepperTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="#66909098" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Focusable="False"
                                              Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Focusable="False"
                                              Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Width="6"
                                       Margin="0,4,2,4"
                                       HorizontalAlignment="Right"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Orientation="Vertical"
                                       Style="{StaticResource ThinScrollBarStyle}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="28,24,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image Width="36"
                       Height="36"
                       Source="/Assets/InputCue.ico"
                       Stretch="Uniform" />
                <StackPanel Margin="12,0,0,0">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="InputCue" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Text="输入状态提示" />
                </StackPanel>
                <Border Margin="12,0,8,0"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="6">
                    <TextBlock x:Name="VersionText"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="v0.0.0" />
                </Border>
                <Button x:Name="UpdateButton"
                        Width="36"
                        Margin="0,0,6,0"
                        AutomationProperties.Name="更新"
                        Click="OnUpdateClick"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="检查更新">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M21,12 A9,9 0 0 1 5.8,18.5 L3,16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.7" />
                            <Path Data="M3,21 L3,16 L8,16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.7" />
                            <Path Data="M3,12 A9,9 0 0 1 18.2,5.5 L21,8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.7" />
                            <Path Data="M21,3 L21,8 L16,8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.7" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Width="36"
                        AutomationProperties.Name="GitHub"
                        Click="OnGitHubClick"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="打开 GitHub">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M15,22 L15,18 A4.8,4.8 0 0 0 14,14.5 C17.3,14.1 20.8,12.9 20.8,7.5 A5.4,5.4 0 0 0 19.4,4 A5,5 0 0 0 19.3,0.5 C19.3,0.5 18,0 15,2 A13.4,13.4 0 0 0 8,2 C5,-0.1 3.7,0.5 3.7,0.5 A5,5 0 0 0 3.6,4 A5.4,5.4 0 0 0 2.2,7.7 C2.2,13.1 5.7,14.2 9,14.7 A4.8,4.8 0 0 0 8,18 L8,22 M8,19 C5,19.9 5,17.5 4,17"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.7" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="PauseButton"
                        MinWidth="92"
                        MinHeight="42"
                        Margin="0,0,12,0"
                        Padding="18,9"
                        FontSize="14"
                        Click="OnPauseClick"
                        Content="暂停" />
                <Border Width="128"
                        MinHeight="42"
                        Padding="14,9"
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="32" Height="32" Margin="0,0,8,0">
                            <Ellipse x:Name="WatchingStatusPulse"
                                     Width="16"
                                     Height="16"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Fill, ElementName=WatchingStatusDot}"
                                     Opacity="0.58"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="WatchingStatusPulseScale"
                                                    ScaleX="0.65"
                                                    ScaleY="0.65" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="WatchingStatusDot"
                                     Width="10"
                                     Height="10"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource ListeningBrush}" />
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="WatchingStatusPulse"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.58"
                                                             To="0"
                                                             Duration="0:0:1.35" />
                                            <DoubleAnimation Storyboard.TargetName="WatchingStatusPulseScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.65"
                                                             To="2"
                                                             Duration="0:0:1.35" />
                                            <DoubleAnimation Storyboard.TargetName="WatchingStatusPulseScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.65"
                                                             To="2"
                                                             Duration="0:0:1.35" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>
                        <TextBlock x:Name="WatchingStatusText"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="正在监听" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="1"
                      Margin="28,22,0,26"
                      Style="{StaticResource OverlayScrollViewerStyle}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnPreviewLayoutChanged">
            <StackPanel Margin="0,0,28,0">
                <Border Padding="14,12"
                        Background="#FFFFF8E8"
                        BorderBrush="#FFF0D38A"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="22"
                                Height="22"
                                VerticalAlignment="Top"
                                Background="#FFFFE7A8"
                                CornerRadius="11">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#FF8A5A00"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Text="!" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="10,1,0,0"
                                   Foreground="#FF73510D"
                                   LineHeight="20"
                                   Text="在部分多人游戏中，本工具可能被反作弊系统误判。游戏玩家请谨慎使用。"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="20"
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="常规" />
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="OnStartWithWindowsChanged"
                                      Unchecked="OnStartWithWindowsChanged"
                                      Content="开机启动" />
                            <CheckBox x:Name="FullScreenAutoPauseCheckBox"
                                      Grid.Column="2"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="OnFullScreenAutoPauseChanged"
                                      Unchecked="OnFullScreenAutoPauseChanged"
                                      ToolTip="视频、游戏等进入全屏时暂停提示，退出全屏后自动恢复"
                                      Content="全屏自动暂停" />
                        </Grid>
                        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       ToolTip="切换输入模式（中文、英文、大写锁定）时始终会立即提示"
                                       Text="同应用内切换输入框时" />
                            <RadioButton x:Name="SameAppPromptAlwaysRadio"
                                         Style="{StaticResource OptionRadioStyle}"
                                         Margin="20,0,0,0"
                                         VerticalAlignment="Center"
                                         GroupName="SameAppPromptMode"
                                         Checked="OnSameAppPromptModeChanged"
                                         ToolTip="每次切换输入框都提示"
                                         Content="始终显示" />
                            <RadioButton x:Name="SameAppPromptDelayRadio"
                                         Style="{StaticResource OptionRadioStyle}"
                                         Margin="20,0,0,0"
                                         VerticalAlignment="Center"
                                         GroupName="SameAppPromptMode"
                                         Checked="OnSameAppPromptModeChanged"
                                         ToolTip="距上次提示超过设定秒数后，切换输入框会重新提示">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="SameAppPromptDelayTextBox"
                                             Width="90"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             TextAlignment="Center"
                                             ToolTip="允许 10 到 3600 秒"
                                             Text="300"
                                             TextChanged="OnSameAppPromptDelayTextChanged" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="秒后显示" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SameAppPromptNeverRadio"
                                         Style="{StaticResource OptionRadioStyle}"
                                         Margin="20,0,0,0"
                                         VerticalAlignment="Center"
                                         GroupName="SameAppPromptMode"
                                         Checked="OnSameAppPromptModeChanged"
                                         ToolTip="同应用停留期间仅提示一次"
                                         Content="始终不显示" />
                        </StackPanel>
                        <Border Height="1" Margin="0,18,0,16" Background="#FFF0F0F1" />
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <StackPanel Width="160">
                                <TextBlock Margin="0,0,0,7" Foreground="{StaticResource MutedBrush}" Text="显示时长 (ms)" />
                                <TextBox x:Name="DisplayDurationTextBox"
                                         Width="160"
                                         HorizontalAlignment="Left"
                                         Text="1000" />
                            </StackPanel>
                            <StackPanel Width="160" Margin="16,0,0,0">
                                <TextBlock Margin="0,0,0,7" Foreground="{StaticResource MutedBrush}" Text="输入后最短 (ms)" />
                                <TextBox x:Name="MinimumDisplayDurationTextBox"
                                         Width="160"
                                         HorizontalAlignment="Left"
                                         Text="300" />
                            </StackPanel>
                            <Button
                                    MinWidth="88"
                                    Margin="16,23,0,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnTimingSettingsClick"
                                    Content="应用" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="20"
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="外观" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="4"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LightBadgeStyleRadio"
                                                 Style="{StaticResource SegmentRadioStyle}"
                                                 GroupName="IndicatorStyle"
                                                 Tag="LightBadge"
                                                 Checked="OnStylePreviewChanged">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="描边" />
                                            <Grid Width="25" Height="25" Margin="10,0,0,0">
                                                <Border Width="20" Height="20"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="#FF000000">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="3" Y="3" />
                                                    </Border.RenderTransform>
                                                </Border>
                                                <Border Width="20" Height="20"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="#FFFFFFFF"
                                                        BorderBrush="#FF000000"
                                                        BorderThickness="1.5">
                                                    <Viewbox Margin="3.5" Stretch="Uniform">
                                                        <Path Data="M0 8.448H39.072V31.728H34.368V12.912H4.512V31.968H0V8.448ZM2.352 24.624H37.056V29.088H2.352V24.624ZM17.04 0H21.792V44.496H17.04V0Z"
                                                              Fill="#FF000000" />
                                                    </Viewbox>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ShadowBadgeStyleRadio"
                                                 Style="{StaticResource SegmentRadioStyle}"
                                                 GroupName="IndicatorStyle"
                                                 Tag="ShadowBadge"
                                                 Checked="OnStylePreviewChanged">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="阴影" />
                                            <Grid Width="25" Height="25" Margin="10,0,0,0">
                                                <Border Width="20" Height="20"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#FFFCFCFC"
                                                        BorderBrush="#FFD4D4D8"
                                                        BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6"
                                                                          Direction="0"
                                                                          Opacity="0.22"
                                                                          ShadowDepth="0"
                                                                          Color="#FF52525B" />
                                                    </Border.Effect>
                                                    <Viewbox Stretch="Uniform">
                                                        <Canvas Width="64" Height="64">
                                                            <Path Data="M15.84 20.56H48.08V39.36H45V23.48H18.84V39.56H15.84V20.56ZM17.44 34.12H46.8V37.08H17.44V34.12ZM30.32 13.4H33.48V50.16H30.32V13.4Z"
                                                                  Fill="#FF52525B" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="DotStyleRadio"
                                                 Style="{StaticResource SegmentRadioStyle}"
                                                 GroupName="IndicatorStyle"
                                                 Tag="Dot"
                                                 Checked="OnStylePreviewChanged">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="圆点" />
                                            <Grid Width="22" Height="22" Margin="10,0,0,0">
                                                <Ellipse x:Name="StyleDotPreview" Width="13" Height="13"
                                                         Fill="#FFE5534B"
                                                         Stroke="#FFFFFFFF"
                                                         StrokeThickness="2" />
                                            </Grid>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="2"
                                    Margin="8,4,0,4"
                                    HorizontalAlignment="Right"
                                    Click="OnResetPlacementClick"
                                    Content="重置" />
                        </Grid>
                        <Border Height="1" Margin="0,16" Background="#FFF0F0F1" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border x:Name="PreviewSurface"
                                        Height="194"
                                        Background="#FFFAFAFA"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Grid>
                                        <Border Width="104"
                                                Height="42"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#FFFFFFFF"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Rectangle x:Name="PreviewCaret"
                                                       Width="2"
                                                       Height="22"
                                                       Margin="12,0,0,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Fill="#FF3F3F46" />
                                        </Border>
                                        <Canvas x:Name="PreviewCanvas" ClipToBounds="True">
                                            <overlay:IndicatorPreviewControl x:Name="PreviewIndicator"
                                                                              Visibility="Collapsed" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Margin="3,0,0,6"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="对齐" />
                                        <UniformGrid x:Name="PositionPicker"
                                                     Width="132"
                                                     Height="132"
                                                     HorizontalAlignment="Left"
                                                     Rows="3"
                                                     Columns="3">
                                            <RadioButton Style="{StaticResource PositionRadioStyle}" GroupName="IndicatorPlacement" Tag="TopLeft" Checked="OnPlacementPreviewChanged" Content="↖" />
                                            <RadioButton Style="{StaticResource PositionRadioStyle}" GroupName="IndicatorPlacement" Tag="Top" Checked="OnPlacementPreviewChanged" Content="↑" />
                                            <RadioButton Style="{StaticResource PositionRadioStyle}" GroupName="IndicatorPlacement" Tag="TopRight" Checked="OnPlacementPreviewChanged" Content="↗" />
                                            <RadioButton Style="{StaticResource PositionRadioStyle}" GroupName="IndicatorPlacement" Tag="Left" Checked="OnPlacementPreviewChanged" Content="←" />
                                            <Border Margin="3" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7">
                                                <Rectangle Width="2" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FF3F3F46" />
                                            </Border>
                                            <RadioButton Style="{StaticResource PositionRadioStyle}" GroupName="IndicatorPlacement" Tag="Right" Checked="OnPlacementPreviewChanged" Content="→" />
                                            <RadioButton Style="{StaticResource PositionRadioStyle}" GroupName="IndicatorPlacement" Tag="BottomLeft" Checked="OnPlacementPreviewChanged" Content="↙" />
                                            <RadioButton Style="{StaticResource PositionRadioStyle}" GroupName="IndicatorPlacement" Tag="Bottom" Checked="OnPlacementPreviewChanged" Content="↓" />
                                            <RadioButton Style="{StaticResource PositionRadioStyle}" GroupName="IndicatorPlacement" Tag="BottomRight" Checked="OnPlacementPreviewChanged" Content="↘" />
                                        </UniformGrid>
                                    </StackPanel>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel x:Name="DotSizePanel">
                                            <TextBlock Margin="0,0,0,5" Foreground="{StaticResource MutedBrush}" Text="圆点尺寸" />
                                            <Border Width="160" HorizontalAlignment="Left" Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="34" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource StepperButtonStyle}" Tag="DotSize:-1" Click="OnStepperClick" Content="−" />
                                                    <TextBox x:Name="DotSizeTextBox" Grid.Column="1" Style="{StaticResource StepperTextBoxStyle}" TextChanged="OnPlacementPreviewChanged" />
                                                    <Button Grid.Column="2" Style="{StaticResource StepperButtonStyle}" Tag="DotSize:1" Click="OnStepperClick" Content="+" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel x:Name="BadgeSizePanel" Visibility="Collapsed">
                                            <TextBlock Margin="0,0,0,5" Foreground="{StaticResource MutedBrush}" Text="徽标尺寸" />
                                            <Border Width="160" HorizontalAlignment="Left" Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="34" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource StepperButtonStyle}" Tag="BadgeSize:-1" Click="OnStepperClick" Content="−" />
                                                    <TextBox x:Name="BadgeSizeTextBox" Grid.Column="1" Style="{StaticResource StepperTextBoxStyle}" TextChanged="OnPlacementPreviewChanged" />
                                                    <Button Grid.Column="2" Style="{StaticResource StepperButtonStyle}" Tag="BadgeSize:1" Click="OnStepperClick" Content="+" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Margin="0,0,0,5" Foreground="{StaticResource MutedBrush}" Text="横向偏移" />
                                            <Border Width="160" HorizontalAlignment="Left" Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="34" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource StepperButtonStyle}" Tag="Horizontal:-1" Click="OnStepperClick" Content="−" />
                                                    <TextBox x:Name="HorizontalOffsetTextBox" Grid.Column="1" Style="{StaticResource StepperTextBoxStyle}" TextChanged="OnPlacementPreviewChanged" />
                                                    <Button Grid.Column="2" Style="{StaticResource StepperButtonStyle}" Tag="Horizontal:1" Click="OnStepperClick" Content="+" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="4">
                                            <TextBlock Margin="0,0,0,5" Foreground="{StaticResource MutedBrush}" Text="纵向偏移" />
                                            <Border Width="160" HorizontalAlignment="Left" Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="34" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource StepperButtonStyle}" Tag="Vertical:-1" Click="OnStepperClick" Content="−" />
                                                    <TextBox x:Name="VerticalOffsetTextBox" Grid.Column="1" Style="{StaticResource StepperTextBoxStyle}" TextChanged="OnPlacementPreviewChanged" />
                                                    <Button Grid.Column="2" Style="{StaticResource StepperButtonStyle}" Tag="Vertical:1" Click="OnStepperClick" Content="+" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="DotColorPanel" Margin="0,18,0,0">
                            <TextBlock Margin="0,0,0,8"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="圆点颜色" />
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <StackPanel Width="160" Margin="0,0,12,0">
                                    <StackPanel Margin="2,0,0,5" Orientation="Horizontal">
                                        <TextBlock Text="中文" />
                                        <Ellipse x:Name="ChineseDotColorSwatch" Width="9" Height="9" Margin="7,0,0,0" Fill="#FFE5534B" />
                                    </StackPanel>
                                    <Border Width="160" Height="36" Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                        <StackPanel Margin="10,0" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="#" />
                                            <TextBox x:Name="ChineseDotColorTextBox" Width="72" MaxLength="6" Margin="2,0,0,0"
                                                     Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                                                     PreviewTextInput="OnHexColorPreviewTextInput" DataObject.Pasting="OnHexColorPasting"
                                                     TextChanged="OnDotColorChanged" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Width="160" Margin="0,0,12,0">
                                    <StackPanel Margin="2,0,0,5" Orientation="Horizontal">
                                        <TextBlock Text="英文" />
                                        <Ellipse x:Name="EnglishDotColorSwatch" Width="9" Height="9" Margin="7,0,0,0" Fill="#FF2F7FD6" />
                                    </StackPanel>
                                    <Border Width="160" Height="36" Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                        <StackPanel Margin="10,0" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="#" />
                                            <TextBox x:Name="EnglishDotColorTextBox" Width="72" MaxLength="6" Margin="2,0,0,0"
                                                     Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                                                     PreviewTextInput="OnHexColorPreviewTextInput" DataObject.Pasting="OnHexColorPasting"
                                                     TextChanged="OnDotColorChanged" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Width="160" Margin="0,0,12,0">
                                    <StackPanel Margin="2,0,0,5" Orientation="Horizontal">
                                        <TextBlock Text="ENG" />
                                        <Ellipse x:Name="EnglishUsDotColorSwatch" Width="9" Height="9" Margin="7,0,0,0" Fill="#FFD99000" />
                                    </StackPanel>
                                    <Border Width="160" Height="36" Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                        <StackPanel Margin="10,0" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="#" />
                                            <TextBox x:Name="EnglishUsDotColorTextBox" Width="72" MaxLength="6" Margin="2,0,0,0"
                                                     Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                                                     PreviewTextInput="OnHexColorPreviewTextInput" DataObject.Pasting="OnHexColorPasting"
                                                     TextChanged="OnDotColorChanged" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Width="160">
                                    <StackPanel Margin="2,0,0,5" Orientation="Horizontal">
                                        <TextBlock Text="大写" />
                                        <Ellipse x:Name="CapsLockDotColorSwatch" Width="9" Height="9" Margin="7,0,0,0" Fill="#FF2F9E68" />
                                    </StackPanel>
                                    <Border Width="160" Height="36" Background="#FFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                        <StackPanel Margin="10,0" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="#" />
                                            <TextBox x:Name="CapsLockDotColorTextBox" Width="72" MaxLength="6" Margin="2,0,0,0"
                                                     Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                                                     PreviewTextInput="OnHexColorPreviewTextInput" DataObject.Pasting="OnHexColorPasting"
                                                     TextChanged="OnDotColorChanged" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="18"
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Expander Foreground="#FF18181B">
                        <Expander.Header>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="诊断详情" />
                        </Expander.Header>
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock x:Name="DiagnosticSummaryText"
                                       Margin="0,0,0,8"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="尚无观察记录。" />
                            <TextBlock x:Name="StatusText"
                                       Margin="0,0,0,12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="诊断探针正在初始化。" />
                            <Border Padding="12"
                                    Background="#FFF8F8F8"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <TextBlock x:Name="DiagnosticText"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="尚未观察到外部应用。" />
                            </Border>
                            <StackPanel Margin="0,12,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Click="OnClearDiagnosticsClick"
                                        Content="清空日志" />
                                <Button Margin="8,0,0,0"
                                        Click="OnExportClick"
                                        Content="导出诊断" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="UpdateToast"
                Grid.RowSpan="2"
                Panel.ZIndex="100"
                MaxWidth="430"
                Margin="0,78,0,0"
                Padding="14,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#FFEFF6FF"
                BorderBrush="#FFBFDBFE"
                BorderThickness="1"
                CornerRadius="9"
                Opacity="0"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  Color="#FF18181B"
                                  Opacity="0.16"
                                  ShadowDepth="3" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="UpdateToastTranslate" Y="-8" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="UpdateToastIconBackground"
                        Width="24"
                        Height="24"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top"
                        Background="#FFDCEEFF"
                        CornerRadius="12">
                    <TextBlock x:Name="UpdateToastIcon"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FF1683FF"
                               FontSize="13"
                               FontWeight="Bold"
                               Text="↻" />
                </Border>
                <TextBlock x:Name="UpdateToastText"
                           MaxWidth="350"
                           VerticalAlignment="Center"
                           Foreground="#FF1E3A5F"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="正在检查更新…"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
